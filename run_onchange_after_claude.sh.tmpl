#!/usr/bin/env bash
set -e

# statusline hash: {{ include "dot_claude/statusline/starship.statusline.toml" | sha256sum }}{{ include "dot_claude/statusline/executable_claude-usage.sh" | sha256sum }}

if [ -z "$CLAUDE_CONFIG_DIR" ]; then
  exit 0
fi

SRC="$HOME/.claude"

# Create destination if needed
mkdir -p "$CLAUDE_CONFIG_DIR"

# Copy contents (not the directory itself)
cp -an "$SRC/." "$CLAUDE_CONFIG_DIR/"
cp -a "$SRC/statusline" "$CLAUDE_CONFIG_DIR/"
cp "$SRC/settings.json" "$CLAUDE_CONFIG_DIR/"
