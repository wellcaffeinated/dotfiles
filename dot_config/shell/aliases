# Shared aliases for bash and zsh

# Editor aliases with fallback
if command -v nvim >/dev/null; then
  alias vim='nvim'
  alias vi='nvim'
fi

# Feature-detected modern tools
if command -v eza >/dev/null; then
  alias ls='eza'                                                          # ls
  alias l='eza -lb --git --classify=auto'                                  # list, size, type, git
  alias ll='eza -lbG --git --classify=auto'                               # long list
  alias llm='eza -lbGd --git --sort=modified'                            # long list, modified date sort
  alias la='eza -lbhHigUmuSa --time-style=long-iso --git --color-scale'  # all list
  alias lx='eza -lbhHigUmuSa@ --time-style=long-iso --git --color-scale' # all + extended list
else
  # Standard ls-based fallbacks
  alias ls='ls --color=auto'                                             # ls with color
  alias l='ls -lhF'                                                      # list, size, type
  alias ll='ls -lhF'                                                     # long list
  alias llm='ls -lhFt'                                                   # long list, modified date sort
  alias la='ls -lAh'                                                     # all list
  alias lx='ls -lAh'                                                     # all + extended list
fi

if command -v bat >/dev/null; then
  alias cat='bat'  # enhanced cat
fi

if command -v ytop >/dev/null; then
  alias top='ytop'  # enhanced top
fi


# Navigation
alias ..='cd ..'
alias ...='cd ../..'


# Safety
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'


# Enhanced grep
alias grep='grep --color=auto'

# Reload shell config
if [ -n "$ZSH_VERSION" ]; then
  alias reload='source ~/.zshrc'
elif [ -n "$BASH_VERSION" ]; then
  alias reload='source ~/.bashrc'
fi

# Tmux aliases
if command -v tmux >/dev/null; then
  alias txa='tmux attach -t'  # attach to session
  alias txad='tmux attach -d -t'  # detach other clients and attach
  alias txs='tmux new-session -s'  # new session
  alias txl='tmux list-sessions'  # list sessions
fi
