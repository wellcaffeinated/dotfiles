# Shared functions for bash and zsh where possible

mkcd() {
  mkdir -p "$1" && cd "$1"
}

projroot() {
  local root
  root=$(git rev-parse --show-toplevel 2>/dev/null)
  [ -n "$root" ] && cd "$root"
}

# Set terminal tab/window title via xterm escape sequence (works in iTerm,
# Terminal.app, most Linux terminal emulators).
term_title() {
  printf '\e]1;%s\a' "$1"
}

# Set terminal title to current path, abbreviated (e.g. ~/c/g/dotfiles).
term_title_pwd() {
  local p="${PWD/#$HOME/~}"
  p=$(printf '%s' "$p" | sed -E 's|([^/])[^/]*/|\1/|g')
  term_title "$p"
}

# Open Claude in a named tmux session. Usage: cc [session-name]
cc() {
  command -v tmux >/dev/null || { echo "tmux not found" >&2; return 1; }
  local name="cc-${1:-$(date +%H%M%S)}"
  tmux new-session -d -s "$name" "claude"
  tmux attach -t "$name"
}

# Prompt to restore existing tmux session on shell login
tmux_session_prompt() {
  # Skip if tmux not available, already in tmux, or non-interactive
  [ -z "$PS1" ] && return
  command -v tmux >/dev/null || return
  [ -n "$TMUX" ] && return

  # Only prompt on SSH connections
  [ -z "$SSH_TTY" ] && return

  # Check for existing sessions
  local sessions
  sessions=$(tmux list-sessions 2>/dev/null)

  if [ -n "$sessions" ]; then
    echo "Existing tmux sessions:"
    echo "$sessions"
    echo
    printf "Restore tmux session? [Y/n/c(reate)] "
    read -r response
    response=${response:-y}  # Default to y

    case "$response" in
      [yY]|[yY][eE][sS])
        exec tmux attach-session
        ;;
      [cC]|[cC][rR][eE][aA][tT][eE])
        exec tmux new-session
        ;;
      *)
        # n or anything else - do nothing
        ;;
    esac
  fi
}
