#!/bin/sh
# River Window Manager Init Script
# Generated by Ansible - customize as needed
# Documentation: https://github.com/riverwm/river/wiki

# ==============================================================================
# APPLICATION KEYBINDINGS
# ==============================================================================

# Launch terminal (alacritty)
riverctl map normal Mod1 Z spawn alacritty

# Launch application launcher (fuzzel)
riverctl map normal Mod1 Space spawn fuzzel

# ==============================================================================
# WINDOW MANAGEMENT
# ==============================================================================

# Close focused window
riverctl map normal Super Q close

# Focus next/previous window
riverctl map normal Super J focus-view next
riverctl map normal Super K focus-view previous

# Swap focused window with next/previous
riverctl map normal Super+Shift J swap next
riverctl map normal Super+Shift K swap previous

# Move focus to next/previous output (monitor)
riverctl map normal Super Period focus-output next
riverctl map normal Super Comma focus-output previous

# Send focused window to next/previous output
riverctl map normal Super+Shift Period send-to-output next
riverctl map normal Super+Shift Comma send-to-output previous

# Bump focused window to top of layout stack
riverctl map normal Super Return zoom

# Toggle float mode for focused window
riverctl map normal Super Space toggle-float

# Toggle fullscreen for focused window
riverctl map normal Super F toggle-fullscreen

# Move floating windows (Super + Mouse drag)
riverctl map-pointer normal Super BTN_LEFT move-view

# Resize floating windows (Super + Right Mouse drag)
riverctl map-pointer normal Super BTN_RIGHT resize-view

# Toggle float on middle mouse button
riverctl map-pointer normal Super BTN_MIDDLE toggle-float

# ==============================================================================
# LAYOUT MANAGEMENT
# ==============================================================================

# Decrease/increase main ratio (for tiling layout)
riverctl map normal Super H send-layout-cmd rivertile "main-ratio -0.05"
riverctl map normal Super L send-layout-cmd rivertile "main-ratio +0.05"

# Increment/decrement main window count
riverctl map normal Super+Shift H send-layout-cmd rivertile "main-count +1"
riverctl map normal Super+Shift L send-layout-cmd rivertile "main-count -1"

# Cycle through available layouts
riverctl map normal Super Up    send-layout-cmd rivertile "main-location top"
riverctl map normal Super Right send-layout-cmd rivertile "main-location right"
riverctl map normal Super Down  send-layout-cmd rivertile "main-location bottom"
riverctl map normal Super Left  send-layout-cmd rivertile "main-location left"

# ==============================================================================
# WORKSPACES (TAGS IN RIVER)
# ==============================================================================

# River uses "tags" instead of traditional workspaces
# Each window can have one or more tags (like i3/sway)

# Switch to tag (workspace) 1-9
for i in $(seq 1 9); do
    tags=$((1 << ($i - 1)))

    # Focus tag
    riverctl map normal Super $i set-focused-tags $tags

    # Move window to tag
    riverctl map normal Super+Shift $i set-view-tags $tags

    # Toggle tag visibility
    riverctl map normal Super+Control $i toggle-focused-tags $tags

    # Toggle window tag membership
    riverctl map normal Super+Shift+Control $i toggle-view-tags $tags
done

# Focus all tags (show all windows)
all_tags=$(((1 << 9) - 1))
riverctl map normal Super 0 set-focused-tags $all_tags

# Move window to all tags
riverctl map normal Super+Shift 0 set-view-tags $all_tags

# ==============================================================================
# SCREENSHOTS
# ==============================================================================

# Full screen screenshot
riverctl map normal None Print spawn "grim ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png"

# Region screenshot (select area with mouse)
riverctl map normal Super Print spawn 'grim -g "$(slurp)" ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png'

# ==============================================================================
# SESSION MANAGEMENT
# ==============================================================================

# Lock screen
riverctl map normal Super+Shift L spawn swaylock

# Exit River
riverctl map normal Super+Shift E exit

# ==============================================================================
# APPEARANCE & BEHAVIOR
# ==============================================================================

# Set background and border color (ARGB format: 0xAARRGGBB)
riverctl background-color 0x002b36  # Dark background
riverctl border-color-focused 0x93a1a1  # Light gray border for focused window
riverctl border-color-unfocused 0x586e75  # Darker gray for unfocused windows
riverctl border-width 2  # 2 pixel borders

# Set keyboard repeat rate
riverctl set-repeat 50 300  # 50ms delay, 300ms repeat

# Make all views with app-id "bar" and any title use client-side decorations
riverctl rule-add -app-id "bar" csd

# ==============================================================================
# INPUT CONFIGURATION
# ==============================================================================

# Touchpad configuration (if applicable)
# Uncomment and adjust as needed
# riverctl input pointer-XXXX-XXXX-XXXX-XXXX events enabled
# riverctl input pointer-XXXX-XXXX-XXXX-XXXX tap enabled
# riverctl input pointer-XXXX-XXXX-XXXX-XXXX natural-scroll enabled

# Keyboard layout (already set by system, but can override here)
# riverctl keyboard-layout us

# ==============================================================================
# LAYOUT GENERATOR
# ==============================================================================

# Set default layout to rivertile (river's default tiling layout)
riverctl default-layout rivertile

# Start rivertile layout generator with padding
rivertile -view-padding 6 -outer-padding 6 &

# ==============================================================================
# AUTOSTART APPLICATIONS
# ==============================================================================

# Status bar
waybar &

# Notification daemon
mako &

# Polkit authentication agent (for GUI password prompts)
/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &

# ==============================================================================
# POWER MANAGEMENT & IDLE
# ==============================================================================

# Screen locker and display power management
# Locks screen after 300 seconds (5 minutes)
# Turns off display after 600 seconds (10 minutes)
# Uses wlr-randr for DPMS (Display Power Management Signaling) control
swayidle -w \
    timeout 300 'swaylock -f' \
    timeout 600 'wlr-randr --output "*" --off' \
    resume 'wlr-randr --output "*" --on' \
    before-sleep 'swaylock -f' &

# ==============================================================================
# XDG DESKTOP PORTAL
# ==============================================================================

# Required for screen sharing, file pickers, etc.
/usr/lib/xdg-desktop-portal-wlr &
sleep 1
/usr/lib/xdg-desktop-portal &
