{
  "permissions": {
    "allow": [],
    "deny": [
      "Read(./.env)",
      "Read(./secrets)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "extraKnownMarketplaces": {
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    }
  },
  "sandbox": {
    "enabled": true
  },
  "enabledPlugins": {
    "obsidian@obsidian-skills": true
  }
}
