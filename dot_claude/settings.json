{
  "permissions": {
    "allow": [],
    "deny": [
      "Read(./.env)",
      "Read(./secrets)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "obsidian@obsidian-skills": true,
    "superpowers@claude-plugins-official": false,
    "context7@claude-plugins-official": true,
    "well-cafe-notebook@well-cafe-skills": true
  },
  "extraKnownMarketplaces": {
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      },
      "autoUpdate": true
    },
    "well-cafe-skills": {
      "source": {
        "source": "github",
        "repo": "wellcaffeinated/well-cafe-skills"
      },
      "autoUpdate": true
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    }
  },
  "sandbox": {
    "enabled": true
  },
  "effortLevel": "high"
}
