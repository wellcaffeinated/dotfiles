# --- Shared config sourcing ---
XDG_SHELL="$HOME/.config/shell"
[ -f "$XDG_SHELL/env" ] && source "$XDG_SHELL/env"
[ -f "$XDG_SHELL/aliases" ] && source "$XDG_SHELL/aliases"
[ -f "$XDG_SHELL/functions" ] && source "$XDG_SHELL/functions"


# --- Antidote (plugin manager) ---
# Load antidote
if [ -f "$HOME/.antidote/antidote.zsh" ]; then
  source "$HOME/.antidote/antidote.zsh"
  antidote load < $HOME/.zsh_plugins.txt
elif [ -f "/usr/share/zsh-antidote/antidote.zsh" ]; then
  source "/usr/share/zsh-antidote/antidote.zsh"
  antidote load < $HOME/.zsh_plugins.txt
elif [ -f "/opt/homebrew/opt/antidote/share/antidote/antidote.zsh" ]; then
  source "/opt/homebrew/opt/antidote/share/antidote/antidote.zsh"
  antidote load < $HOME/.zsh_plugins.txt
elif command -v git >/dev/null; then
  echo "Installing antidote locally..."
  # first, run this from an interactive zsh terminal session:
  git clone --depth=1 https://github.com/mattmc3/antidote.git ${ZDOTDIR:-~}/.antidote
  source ${ZDOTDIR:-~}/.antidote/antidote.zsh
  antidote load < $HOME/.zsh_plugins.txt
else
  echo "Antidote not found! Please install it."
fi

# --- Starship prompt ---
if command -v starship >/dev/null; then
  eval "$(starship init zsh)"
fi

# Use emacs keybindings (disable vi mode)
bindkey -e

# --- Zsh options ---
setopt autocd # Change directories by typing their name
setopt correct # Suggest corrections for mistyped commands
setopt extendedglob # Enable advanced globbing features
setopt histignoredups # Avoid duplicate entries in history
setopt sharehistory # Share history across sessions
setopt incappendhistory # Append to history file incrementally
setopt interactivecomments # Allow comments in interactive commands
setopt notify # Notify immediately when background jobs complete

# --- History settings ---
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down

# --- More keybindings ---
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[[3~' delete-char


# Enable completion with daily cache refresh
autoload -Uz compinit
() {
  local dump="${ZDOTDIR:-$HOME}/.zcompdump"
  if [[ -n ${dump}(#qNmh+24) ]]; then
    compinit
  else
    compinit -C
  fi
}

# Completion matching: case-insensitive, then partial-word, then substring
zstyle ':completion:*' matcher-list \
  'm:{a-z}={A-Z}' \
  'm:{a-zA-Z}={A-Za-z}' \
  'r:|[._-]=* r:|=*' \
  'l:|=* r:|=*'
zstyle ':completion:*' menu select
zstyle ':completion:*:default' list-colors ${(s.:.)LS_COLORS}

# Enable completions for ls-like aliases — fall back to ls completion if _eza isn't available
if command -v eza >/dev/null; then
  if (( $+functions[_eza] )); then
    compdef la=eza l=eza ll=eza llm=eza lx=eza ls=eza
  else
    compdef la=ls l=ls ll=ls llm=ls lx=ls
  fi
fi


if command -v fastfetch > /dev/null; then
  fastfetch
fi

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

if command -v zoxide >/dev/null; then
  eval "$(zoxide init zsh)"
fi

# --- Navi (cheatsheet tool) ---
# Ctrl+G to trigger navi widget
if command -v navi >/dev/null; then
  eval "$(navi widget zsh)"
fi

# --- Terminal title hook (iTerm on macOS only) ---
# Function defined in ~/.config/shell/functions
if [ "$(uname)" = "Darwin" ] && [ -d "/Applications/iTerm.app" ]; then
  autoload -Uz add-zsh-hook
  add-zsh-hook precmd term_title_pwd
fi

# --- Tmux session restore prompt ---
# Function defined in ~/.config/shell/functions
tmux_session_prompt
