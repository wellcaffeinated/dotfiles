# --- Shared config sourcing ---
XDG_SHELL="$HOME/.config/shell"
[ -f "$XDG_SHELL/env" ] && source "$XDG_SHELL/env"
[ -f "$XDG_SHELL/aliases" ] && source "$XDG_SHELL/aliases"
[ -f "$XDG_SHELL/functions" ] && source "$XDG_SHELL/functions"


# --- Antidote (plugin manager) ---
# Load antidote
if [ -f "$HOME/.antidote/antidote.zsh" ]; then
  source "$HOME/.antidote/antidote.zsh"
  antidote load < $HOME/.zsh_plugins.txt
elif [ -f "/usr/share/zsh-antidote/antidote.zsh" ]; then
  source "/usr/share/zsh-antidote/antidote.zsh"
  antidote load < $HOME/.zsh_plugins.txt
elif [ -f "/opt/homebrew/opt/antidote/share/antidote/antidote.zsh" ]; then
  source "/opt/homebrew/opt/antidote/share/antidote/antidote.zsh"
  antidote load < $HOME/.zsh_plugins.txt
else
  echo "Antidote not found! Please install it."
fi

# --- Starship prompt ---
if command -v starship >/dev/null; then
  eval "$(starship init zsh)"
fi

# --- Zsh options ---
setopt autocd # Change directories by typing their name
setopt correct # Suggest corrections for mistyped commands
setopt extendedglob # Enable advanced globbing features
setopt histignoredups # Avoid duplicate entries in history
setopt sharehistory # Share history across sessions
setopt incappendhistory # Append to history file incrementally
setopt interactivecomments # Allow comments in interactive commands
setopt notify # Notify immediately when background jobs complete

# --- History settings ---
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down

# --- More keybindings ---
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[[3~' delete-char


# Enable completion
autoload -Uz compinit && compinit


if command -v fastfetch > /dev/null; then
  fastfetch
fi

# bun completions
[ -s "/home/wellcaffeinated/.bun/_bun" ] && source "/home/wellcaffeinated/.bun/_bun"

if command -v zoxide >/dev/null; then
  eval "$(zoxide init zsh)"
fi
